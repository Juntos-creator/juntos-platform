# ========================================================
# JUNTOS - Variables de entorno
# Copia este archivo a .env.local y completa los valores
# ========================================================

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# IMPORTANTE: la service_role key NUNCA se expone al cliente.
# Solo se usa en Server Actions / Route Handlers (audit log inmutable).
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Pricing / Regional (RD) ---
NEXT_PUBLIC_HOURLY_RATE_DOP=900
NEXT_PUBLIC_ITBIS_RATE=0.18

# --- Pasarela de pago (POR CONFIRMAR - CONFIG_REQUIRED por defecto) ---
# PAYMENT_PROVIDER=AZUL | CARDNET | PAYPAL
PAYMENT_PROVIDER=CONFIG_REQUIRED
